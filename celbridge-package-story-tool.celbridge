[celbridge]
celbridge-version = "1.7.0"
project-version = "0.1.0"

[celbridge.explorer]
exclude = [".gitignore", ".DS_Store", "Thumbs.db", "desktop.ini", "deno.json"]

[celbridge.search]
exclude = ["tools/story-builder/docs"]

[celbridge.packages]
folders = ["tools"]

[[shortcut]]
resource = "README.md"
icon = "bs-book"
open-on-load = true

[[shortcut]]
resource = "stories/examples.story"
icon = "bs-easel"
open-on-load = true
